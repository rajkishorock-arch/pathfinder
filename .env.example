# Pathfinder - Environment Configuration Example
# Copy this file to .env.local for local development. NEVER commit secret keys.

# Application Configuration
VITE_APP_TITLE=Pathfinder
VITE_APP_URL=http://localhost:5173

# Supabase Production Database & Auth Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
